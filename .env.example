# =====================================================================
# Food Guard — variáveis de ambiente
# Copie para .env.local e preencha. Sem chaves, o app roda em "modo dev"
# (degradação graciosa: leads são logados no console, CTAs usam fallback).
# =====================================================================

# URL pública do site (usada em metadata/SEO/sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (captura de lead) ------------------------------------
# Em https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Service role: NUNCA expor no client. Usada só em API routes (server).
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (e-mail transacional com o relatório) ------------------
# https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM="Food Guard <diagnostico@seudominio.com.br>"

# --- Calendly (CTA primário: agendar avaliação com o RT) -----------
# URL pública do seu evento, ex: https://calendly.com/renan-foodguard/avaliacao
NEXT_PUBLIC_CALENDLY_URL=

# --- Asaas (CTA secundário: checkout / assinatura) -----------------
# https://www.asaas.com → Integrações → API Key
ASAAS_API_KEY=
# Ambiente: "sandbox" ou "production"
ASAAS_ENV=sandbox
# Fallback: links de pagamento estáticos por plano (se não usar a API)
ASAAS_PAYMENT_LINK_BASICO=
ASAAS_PAYMENT_LINK_ESSENCIAL=
ASAAS_PAYMENT_LINK_PREMIUM=
# Token para validar o webhook de confirmação de pagamento
ASAAS_WEBHOOK_TOKEN=

# --- Analytics (opcional) ------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Contato (usado no rodapé / página de contato) -----------------
NEXT_PUBLIC_WHATSAPP=5511999999999
NEXT_PUBLIC_CONTACT_EMAIL=contato@foodguard.com.br

# --- Fase 3: agentes (prospecção, qualificação, conteúdo) ----------
# Claude API — sem esta chave, os agentes caem em rascunho determinístico.
# https://platform.claude.com → API Keys
ANTHROPIC_API_KEY=
# Segredo para autenticar os cron jobs da Vercel (Authorization: Bearer ...)
CRON_SECRET=
# WhatsApp Cloud API (envio do outbound após aprovação) — opcional por ora
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Painel interno de aprovação (/admin/*) — Basic Auth. Sem isso, o painel fica 503.
ADMIN_USER=
ADMIN_PASSWORD=
# E-mail interno para alertas (ex.: lead tier A). Default: NEXT_PUBLIC_CONTACT_EMAIL.
TEAM_NOTIFY_EMAIL=

# --- Maestro dos agentes (orquestrador determinístico) -------------
# "simulacao" = registra e NÃO envia (padrão seguro) · "real" = libera execução
AGENTS_MODE=simulacao
# Botão de pânico: "on" desliga TODOS os agentes na hora
AGENTS_KILL_SWITCH=off
