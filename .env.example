# ===================================================
# Food Guard — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite o .env.local no Git.
# ===================================================

# DocuSign — Credenciais da conta (Settings > Apps and Keys)
DOCUSIGN_ACCOUNT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
DOCUSIGN_INTEGRATION_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
DOCUSIGN_USER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# DocuSign — Chave privada RSA (gerada ao criar o app em DocuSign)
# Cole o conteúdo do arquivo .pem em uma linha, substituindo as quebras por \n
# Exemplo: -----BEGIN RSA PRIVATE KEY-----\nMIIEo...\n-----END RSA PRIVATE KEY-----
DOCUSIGN_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nSUA_CHAVE_AQUI\n-----END RSA PRIVATE KEY-----

# DocuSign — Template IDs (um por plano, criados em Templates no DocuSign)
DOCUSIGN_TEMPLATE_ID_ESSENCIAL=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
DOCUSIGN_TEMPLATE_ID_CONFORMIDADE=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
DOCUSIGN_TEMPLATE_ID_PREMIUM=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# DocuSign — Use a URL de demo para testes, remova (ou comente) em produção
# DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi

# URL pública do site (usado como returnUrl após assinatura)
SITE_URL=https://foodguardassessoria.com.br
